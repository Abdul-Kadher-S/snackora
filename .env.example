# Database Connection
# For local development (SQLite):
DATABASE_URL="file:./dev.db"
# For production on Vercel with Supabase PostgreSQL:
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[YOUR-PROJECT]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Project & Realtime Credentials (Client-Safe)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-publishable-key"

# Admin Authentication Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_this_to_a_secure_admin_password"
ADMIN_JWT_SECRET="generate_a_random_secret_string_minimum_32_chars"

# Public App Configuration
NEXT_PUBLIC_APP_NAME="SNACKORA"
